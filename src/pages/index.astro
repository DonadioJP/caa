---
import Base from '../layouts/Base.astro';
import Paisagem from '../components/marca/Paisagem.astro';
import { taxonomia } from '../data/taxonomia';
import { guiasPublicos, urlDoGuia } from '../lib/conteudo';

const secoes = taxonomia.filter((n) => n.ativo !== false);
const recentes = (await guiasPublicos()).sort((a, b) => +b.data.publicado - +a.data.publicado).slice(0, 6);
---
<Base titulo="Início">
  <Paisagem slot="abertura" />
  <section class="hero">
    <h1>Do solo ao leite, a criação animal como parte do ecossistema.</h1>
    <p>Guias práticos e baseados em evidências para produtores, estudantes e técnicos — com aulas, vídeos e calculadoras.</p>
    <a class="botao" href="/producao/bovinocultura-leite/">Começar pela bovinocultura de leite</a>
  </section>

  <h2>Seções</h2>
  <ul class="cartoes">
    {secoes.map((s) => (
      <li><a class="cartao" href={`/${s.slug}/`}><strong>{s.nome}</strong>{s.descricao && <span>{s.descricao}</span>}</a></li>
    ))}
  </ul>

  {recentes.length > 0 && (
    <>
      <h2>Guias recentes</h2>
      <ul class="cartoes">
        {recentes.map((g) => (
          <li><a class="cartao" href={urlDoGuia(g.id)}><strong>{g.data.titulo}</strong><span>{g.data.descricao}</span></a></li>
        ))}
      </ul>
    </>
  )}
</Base>
<style>
  .hero { padding: 1.75rem 0 .5rem; }
  .hero h1 { max-width: 20ch; }
  .hero p { font-size: 1.3rem; line-height: 1.45; color: var(--tinta-suave); max-width: 34rem; margin: 0 0 1.25rem; }
</style>
