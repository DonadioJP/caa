---
import Base from '../layouts/Base.astro';
import { taxonomia } from '../data/taxonomia';
import { guiasPublicos, urlDoGuia } from '../lib/conteudo';

const secoes = taxonomia.filter((n) => n.ativo !== false);
const recentes = (await guiasPublicos()).sort((a, b) => +b.data.publicado - +a.data.publicado).slice(0, 6);
---
<Base titulo="Início">
  <section class="hero">
    <h1>Criação Animal Agroecológica</h1>
    <p>Ciência, prática e ética para uma pecuária resiliente e integrada à natureza.</p>
  </section>

  <!-- TODO: mapa interativo SVG do sistema de produção -->

  <h2>Seções</h2>
  <ul class="cartoes">
    {secoes.map((s) => (
      <li><a class="cartao" href={`/${s.slug}/`}><strong>{s.nome}</strong>{s.descricao && <span>{s.descricao}</span>}</a></li>
    ))}
  </ul>

  {recentes.length > 0 && (
    <>
      <h2>Guias recentes</h2>
      <ul class="cartoes">
        {recentes.map((g) => (
          <li><a class="cartao" href={urlDoGuia(g.id)}><strong>{g.data.titulo}</strong><span>{g.data.descricao}</span></a></li>
        ))}
      </ul>
    </>
  )}
</Base>
<style>
  .hero { padding: 2.5rem 0 1rem; }
  .hero p { font-size: 1.2rem; color: var(--tinta-suave); max-width: 32rem; }
</style>
