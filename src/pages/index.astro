---
import Base from '../layouts/Base.astro';
import MapaPropriedade from '../components/marca/MapaPropriedade.astro';
import { guiasPublicos, urlDoGuia } from '../lib/conteudo';

const recentes = (await guiasPublicos()).sort((a, b) => +b.data.publicado - +a.data.publicado).slice(0, 6);
---
<Base titulo="Início">
  <MapaPropriedade slot="abertura" />

  {recentes.length > 0 && (
    <>
      <h2>Guias recentes</h2>
      <ul class="cartoes">
        {recentes.map((g) => (
          <li><a class="cartao" href={urlDoGuia(g.id)}><strong>{g.data.titulo}</strong><span>{g.data.descricao}</span></a></li>
        ))}
      </ul>
    </>
  )}
</Base>
