---
const { url, titulo } = Astro.props as { url: string; titulo: string };
---
<div class="video">
  <iframe src={url} title={`Vídeo: ${titulo}`} loading="lazy" allowfullscreen
    sandbox="allow-same-origin allow-scripts allow-popups allow-forms"></iframe>
</div>
<style>
  .video { aspect-ratio: 16 / 9; border-radius: var(--raio); overflow: hidden; background: #000; margin: 1rem 0; }
  iframe { width: 100%; height: 100%; border: 0; }
</style>
