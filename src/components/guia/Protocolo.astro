---
const { titulo = 'Protocolo' } = Astro.props;
---
<section class="protocolo">
  <p class="rotulo">Protocolo</p>
  <h4>{titulo}</h4>
  <slot />
</section>
<style>
  .protocolo { background: var(--verde-claro); border-radius: var(--raio); padding: 1rem 1.25rem; margin: 1.5rem 0; }
  .rotulo { text-transform: uppercase; letter-spacing: .08em; font-size: .72rem; font-weight: 700; color: var(--verde); margin: 0; }
  h4 { margin: .2rem 0 .5rem; font-family: var(--fonte-titulo); font-size: 1.1rem; }
  .protocolo :global(ol) { padding-left: 1.25rem; margin: 0; }
  .protocolo :global(li) { margin-bottom: .4rem; }
</style>
