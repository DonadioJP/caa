---
import type { CollectionEntry } from 'astro:content';
const { ferramenta } = Astro.props as { ferramenta: CollectionEntry<'ferramentas'> };
const { nome, descricao, tipo, src, status } = ferramenta.data;
---
<section class="calc">
  <h2>Calculadora: {nome}</h2>
  <p>{descricao}</p>
  {status !== 'pronta' && <p class="selo">Em desenvolvimento</p>}
  {status === 'pronta' && tipo === 'shinylive' && (
    <iframe src={src} title={nome} loading="lazy"></iframe>
  )}
  {status === 'pronta' && tipo === 'externo' && <a class="botao" href={src}>Abrir calculadora</a>}
  {/* tipo js: importe o componente da calculadora aqui quando existir */}
</section>
<style>
  iframe { width: 100%; min-height: 32rem; border: 1px solid var(--borda); border-radius: var(--raio); }
</style>
