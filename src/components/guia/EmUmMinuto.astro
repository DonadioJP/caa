---
const { itens } = Astro.props as { itens: string[] };
---
<section class="minuto" aria-labelledby="minuto-t">
  <h2 id="minuto-t" class="rotulo">Em 1 minuto</h2>
  <ul>{itens.map((i) => <li>{i}</li>)}</ul>
</section>
<style>
  .minuto { background: var(--pasto-tinta); border-radius: var(--raio); padding: 1.1rem 1.25rem 1.2rem; margin: 1.5rem 0 2rem; }
  h2.rotulo { color: var(--pasto); margin: 0 0 .5rem; padding: 0; border: 0; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .45rem; }
  li { position: relative; padding-left: 1.4rem; font-size: 1.15rem; line-height: 1.45; }
  li::before { content: ''; position: absolute; left: 0; top: .5em; width: .6rem; height: .6rem; border-radius: 50%; background: var(--pasto); }
</style>
