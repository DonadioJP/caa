---
const { titulo = 'Checklist' } = Astro.props;
---
<section class="checklist">
  <p class="rotulo">Checklist</p>
  <h4>{titulo}</h4>
  <slot />
</section>
<script>
  // Marca/desmarca itens ao tocar — útil no celular, no campo.
  document.querySelectorAll<HTMLLIElement>('.checklist li').forEach((li) => {
    li.setAttribute('role', 'checkbox');
    li.setAttribute('aria-checked', 'false');
    li.tabIndex = 0;
    const alternar = () => li.setAttribute('aria-checked', String(li.getAttribute('aria-checked') !== 'true'));
    li.addEventListener('click', alternar);
    li.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); alternar(); } });
  });
</script>
<style>
  .checklist { border: 1px solid var(--borda); border-radius: var(--raio); padding: 1.1rem 1.25rem; margin: 1.75rem 0; background: var(--superficie); }
  .rotulo { color: var(--terra); }
  h4 { margin: .15rem 0 .6rem; font-size: 1.25rem; }
  .checklist :global(ul) { list-style: none; padding: 0; margin: 0; }
  .checklist :global(li) { position: relative; padding: .45rem 0 .45rem 2.1rem; cursor: pointer; border-radius: 4px; }
  .checklist :global(li + li) { border-top: 1px dashed var(--borda); }
  .checklist :global(li)::before { content: ''; position: absolute; left: 0; top: .6rem; width: 1.3rem; height: 1.3rem; border: 2px solid var(--terra); border-radius: 5px; }
  .checklist :global(li[aria-checked='true']) { color: var(--tinta-suave); text-decoration: line-through; }
  .checklist :global(li[aria-checked='true'])::before { background: var(--terra); }
  .checklist :global(li[aria-checked='true'])::after { content: ''; position: absolute; left: .45rem; top: .78rem; width: .4rem; height: .75rem; border: solid var(--superficie); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
</style>
